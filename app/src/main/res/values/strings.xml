    <string name="onboarding_intro_core_title">Core Value</string>
    <string name="onboarding_intro_core_item_1">No more fighting sleep while staring at bus stops</string>
    <string name="onboarding_intro_core_item_2">Built for commuters who need reliable wake-up timing</string>
    <string name="onboarding_intro_core_item_3">Rest with confidence and wake up right before arrival</string>
    <string name="onboarding_intro_logic_title">How It Works</string>
    <string name="onboarding_intro_logic_item_1">Worried about battery drain? We optimize for power usage</string>
    <string name="onboarding_intro_logic_item_2">Uses our dynamic location polling strategy</string>
    <string name="onboarding_intro_logic_item_3">Checks less often when far away to save battery</string>
    <string name="onboarding_intro_logic_item_4">Increases precision as you approach the destination</string>
    <string name="onboarding_intro_privacy_title">Privacy Promise</string>
    <string name="onboarding_intro_privacy_item_1">Your privacy and data safety come first</string>
    <string name="onboarding_intro_privacy_item_2">Location data is processed only on your device</string>
    <string name="onboarding_intro_privacy_item_3">We do not upload location data to any server</string>
    <string name="onboarding_intro_privacy_item_4">Enable permission with confidence for precise reminders</string>
    <string name="onboarding_location_permission_title">Allow Precise Location</string>
    <string name="onboarding_location_permission_body">Geo Alarm collects precise location data to let you set destinations and enable destination alarms, even when the app is closed or not in use. Location data is processed on this device to detect when you enter the alarm area. It is not sent to Geo Alarm servers or used for advertising. Background location access is requested only when you enable an alarm.</string>
